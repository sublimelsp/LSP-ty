{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>sublimelsp/renovate-preset",
    "github>sublimelsp/renovate-preset:automerge-server"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^plugin/constants\\.py$/"
      ],
      "matchStrings": [
        "SERVER_VERSION = \"(?<currentValue>.+?)\""
      ],
      "datasourceTemplate": "github-releases",
      "packageNameTemplate": "astral-sh/ty"
    }
  ],
  "packageRules": [
    {
      "description": "Automerge minor updates of the 0.x server too, which the automerge-server preset leaves out",
      "matchPackageNames": [
        "astral-sh/ty"
      ],
      "matchUpdateTypes": [
        "minor"
      ],
      "automerge": true
    }
  ]
}
